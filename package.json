{
	"name": "google-maps-react-markers-monorepo",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.23.0",
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"build": "pnpm --filter google-maps-react-markers build",
		"dev": "pnpm --filter google-maps-react-markers dev",
		"docs:dev": "pnpm build && pnpm --parallel --filter google-maps-react-markers --filter docs dev",
		"docs:build": "pnpm build && pnpm --filter docs build",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix && prettier --write .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "pnpm -r typecheck",
		"test": "pnpm --filter google-maps-react-markers test",
		"check:package": "pnpm --filter google-maps-react-markers check:package",
		"size": "pnpm --filter google-maps-react-markers size",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"release": "pnpm build && changeset publish",
		"prepare": "husky || true"
	},
	"lint-staged": {
		"*.{ts,tsx,js,mjs}": "eslint --fix",
		"*": "prettier --write --ignore-unknown"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@eslint/js": "^10.0.1",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "~10.1.8",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.14.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.2",
		"prettier": "^3.10.1",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.74.0"
	}
}
