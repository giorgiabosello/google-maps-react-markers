{
	"name": "google-maps-react-markers",
	"version": "3.0.1",
	"description": "Google Maps for React 19: render any React component as a marker. Advanced markers or custom overlays, drag and drop, clustering-ready, SSR safe and fully typed.",
	"author": "Giorgia Bosello",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/giorgiabosello/google-maps-react-markers.git",
		"directory": "packages/google-maps-react-markers"
	},
	"homepage": "https://giorgiabosello.github.io/google-maps-react-markers/",
	"bugs": "https://github.com/giorgiabosello/google-maps-react-markers/issues",
	"funding": "https://www.buymeacoffee.com/giorgiabosello",
	"keywords": [
		"react",
		"react-19",
		"nextjs",
		"google-maps",
		"google-maps-react",
		"markers",
		"advanced-markers",
		"overlay",
		"map",
		"clustering"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"check:package": "publint --strict --pack npm && attw --pack . --profile esm-only",
		"size": "size-limit",
		"prepack": "pnpm build && cp ../../README.md ../../LICENCE.md .",
		"postpack": "rm -f README.md LICENCE.md"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"dependencies": {
		"@googlemaps/js-api-loader": "^2.1.3",
		"@types/google.maps": "^3.67.0"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@size-limit/preset-small-lib": "^14.3.0",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/react": "^19.3.3",
		"@types/react-dom": "^19.3.0",
		"@vitest/coverage-v8": "^5.1.2",
		"jsdom": "^31.0.1",
		"publint": "^0.3.25",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"size-limit": "^14.3.0",
		"tsdown": "^0.23.7",
		"typescript": "~6.0.3",
		"vitest": "^5.1.2"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
