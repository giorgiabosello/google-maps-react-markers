# Google Maps Platform key. Without it the maps run in development mode (watermarked, Google's own style).
# For local work, use a separate key restricted to http://google-maps-react-markers.test:3000/*
# and open the site on that host (see CONTRIBUTING.md). Never commit .env.local.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID for advanced markers. Defaults to Google's DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
