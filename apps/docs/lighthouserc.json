{
	"ci": {
		"collect": {
			"startServerCommand": "node scripts/serve.mjs 4173",
			"startServerReadyPattern": "Serving",
			"url": [
				"http://127.0.0.1:4173/",
				"http://127.0.0.1:4173/docs/getting-started/",
				"http://127.0.0.1:4173/docs/accessibility/",
				"http://127.0.0.1:4173/docs/examples/few-markers/",
				"http://127.0.0.1:4173/docs/examples/many-markers/"
			],
			"numberOfRuns": 1,
			"settings": {
				"preset": "desktop",
				"chromeFlags": "--no-sandbox"
			}
		},
		"assert": {
			"assertions": {
				"categories:accessibility": ["error", { "minScore": 1 }],
				"categories:seo": ["error", { "minScore": 0.9 }],
				"categories:best-practices": ["warn", { "minScore": 0.9 }],
				"categories:performance": ["warn", { "minScore": 0.8 }]
			}
		},
		"upload": {
			"target": "filesystem",
			"outputDir": "lighthouse-report"
		}
	}
}
